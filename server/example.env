# Server Configuration
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/youngmindsclub

# Client URL - Update this to match your frontend URL
CLIENT_URL=http://localhost:5173

# CORS Configuration - Comma-separated list of allowed origins
# Add all domains that should be allowed to access your API
CORS_URL_LIST=http://localhost:5173,http://localhost:3000,https://your-production-domain.com

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Google OAuth
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Cloudinary Configuration (for image uploads)
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (AWS SES)
# Get these from AWS IAM Console (Access Key for external app)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SMTP_FROM=noreply@youngminds.club
